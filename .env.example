# Copy to .env and fill in. Never commit .env.

# Reasoning model (any OpenAI-compatible endpoint or OpenRouter)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.5

# Image generation
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2

# Fulfilment
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Reports, alerts, kill switch
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Control service
MONGODB_URI=mongodb://localhost:27017/adinkra
DAILY_BUDGET_USD=5
MARGIN_FLOOR_PCT=30
MAX_PUBLISH_PER_DAY=3

# Email (optional). Yahoo needs an app password, not your login password.
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=

# Factory pacing
CYCLE_INTERVAL_HOURS=24
MAX_DRAFTS_PER_CYCLE=1
MAX_PENDING_REVIEW=5

# Optional second reviewer for the quality gate (needs credit on the account)
SECOND_REVIEWER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Cheaper provider for the text-only brief step (opt-in)
BRIEFS_PROVIDER=
DEEPSEEK_MODEL=deepseek-flash
